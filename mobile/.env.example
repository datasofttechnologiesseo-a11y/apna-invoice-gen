# Copy to .env (git-ignored) to point a dev build somewhere other than the defaults.
# Defaults: development → http://127.0.0.1:8741 (iOS simulator reaches the Mac's localhost),
#           release     → https://apnainvoice.com
#
# Real phone on the same Wi-Fi as your Mac: use the Mac's LAN IP and start Laravel with
#   php artisan serve --host=0.0.0.0 --port=8741
# EXPO_PUBLIC_WEB_URL=http://192.168.1.20:8741
#
# Staging server:
# EXPO_PUBLIC_WEB_URL=https://staging.apnainvoice.com
