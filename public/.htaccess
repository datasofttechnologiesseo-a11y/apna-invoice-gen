<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical host: force HTTPS + strip www, but only for the production
    # domain so local/dev hosts are untouched. Keep in sync with APP_URL
    # (https://apnainvoice.com) — canonicals, sitemap and OG URLs are built
    # from it, and Google treats http/https/www variants as duplicates.
    RewriteCond %{HTTP_HOST} ^www\.apnainvoice\.com$ [NC]
    RewriteRule ^ https://apnainvoice.com%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^apnainvoice\.com$ [NC]
    RewriteRule ^ https://apnainvoice.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Text responses compress ~85% (the 213 KB home page becomes ~30 KB) —
# critical for the 4G Android audience this product targets. Images, fonts
# (woff/woff2) and PDFs are already compressed and are left alone.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/csv
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/manifest+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon image/vnd.microsoft.icon font/ttf font/otf
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    # HTML stays uncached so meta/content changes go live immediately.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # All CSS/JS (and any font Vite bundles) ship from /build/assets with an
    # 8-character content hash in the filename, so they can be cached forever:
    # a new deploy changes the filename.
    <FilesMatch "-[A-Za-z0-9_\-]{8}\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Stable names that must be re-checked on every visit, or a new service
    # worker / app manifest would sit unseen behind the browser cache.
    <FilesMatch "^(service-worker\.js|manifest\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Static files never pass through Laravel's SecurityHeaders middleware.
    Header set X-Content-Type-Options "nosniff"
</IfModule>
